# Configuration for MT5 Account Services
# Copy this to config.yaml and fill in your details

# Redis broker configuration (now using Redis Streams for reliability)
broker:
  type: redis
  host: localhost                # Use 'localhost' if Redis is on same machine
                                 # Use MacBook IP (e.g., '192.168.1.100') if Redis is on different machine
  port: 6379
  password: null                 # Set password if Redis requires authentication (RECOMMENDED for remote)
  db: 0
  # Redis Streams specific settings
  max_stream_length: 10000       # Keep last 10k messages per stream (prevents unlimited growth)
  claim_min_idle_time: 60000     # Claim pending messages after 60 seconds (milliseconds)
  # Note: Each account automatically gets its own consumer group for message isolation

# CROSS-PLATFORM DEPLOYMENT NOTES:
# - If running Redis on MacBook and MT5 services on Windows:
#   1. Set host to MacBook IP address (e.g., '192.168.1.100')
#   2. Enable password authentication in Redis
#   3. Configure MacBook Redis to bind to 0.0.0.0 (not 127.0.0.1)
#   4. Open port 6379 in MacBook firewall
# - See CROSS_PLATFORM_DEPLOYMENT.md for detailed setup

# MT5 Accounts
# Add one entry per MT5 account
accounts:
  - account_id: account_1
    account_number: 12345678
    password: "your_password_here"
    server: "YourBroker-Demo"
    mt5_path: "C:\\Program Files\\MetaTrader 5\\terminal64.exe"  # Windows path
    enabled: true
  
  - account_id: account_2
    account_number: 87654321
    password: "your_password_here"
    server: "YourBroker-Demo"
    mt5_path: "C:\\Program Files\\MetaTrader 5 - Account2\\terminal64.exe"
    enabled: true
  
  - account_id: account_3
    account_number: 11223344
    password: "your_password_here"
    server: "AnotherBroker-Live"
    mt5_path: "C:\\Program Files\\MetaTrader 5 - Account3\\terminal64.exe"
    enabled: false  # Disabled account

# Strategy configuration
strategy:
  # Accounts to target (null = all accounts)
  target_accounts: null  # or ["account_1", "account_2"]
  
  # Risk management
  max_position_size: 0.1  # Maximum lots per trade
  max_daily_loss: 100.0   # Maximum daily loss in account currency
  max_open_positions: 5   # Maximum concurrent positions
  
  # Strategy parameters
  strategies:
    - name: SMA_Crossover
      symbol: EURUSD
      timeframe: M15
      enabled: true
      parameters:
        fast_period: 10
        slow_period: 20
    
    - name: SMA_Crossover
      symbol: GBPUSD
      timeframe: M15
      enabled: true
      parameters:
        fast_period: 10
        slow_period: 20

# Monitoring configuration
monitoring:
  db_path: "trading_platform.db"
  stats_interval: 60  # seconds
  log_level: INFO

# Logging
logging:
  level: INFO
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  file: "logs/trading_platform.log"
  max_bytes: 10485760  # 10MB
  backup_count: 5
